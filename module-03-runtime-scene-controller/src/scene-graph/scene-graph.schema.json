{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroscape.local/schemas/scene-graph.schema.json",
  "title": "NeuroScape Scene Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "worldPosition",
          "neighbors",
          "ambientAssetIds",
          "eventAssetIds"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "worldPosition": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" }
          },
          "neighbors": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "ambientAssetIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "eventAssetIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
