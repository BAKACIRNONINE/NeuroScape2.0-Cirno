{
  "schema_version": "semantic_scene_graph_v1",
  "status": "design_locked_for_planner_migration",
  "purpose": "Constrain feasible spatial progression while leaving destination choice and acoustic realization to Decision 2 semantic reasoning.",
  "planner_principles": [
    "All participants begin at forest_clearing.",
    "Neighbors constrain feasible destinations; they do not encode which EEG state or adaptation intent should choose a destination.",
    "Node descriptions characterize places, not policies.",
    "audio_coverage lists currently available building blocks and is not a fixed recipe.",
    "A scene is a semantic composition of reusable assets, not a one-to-one audio package.",
    "Journey-level adaptation emerges from repeated local adaptations and adjacent-node progressions; no separate Route Planner LLM call is required.",
    "Progression pressure may increase the desirability of spatial evolution but must not select a destination deterministically."
  ],
  "start_node_id": "forest_clearing",
  "recommended_major_transitions_per_10min_session": {
    "min": 0,
    "max": 2,
    "note": "Major transitions should remain sparse; local acoustic evolution supplies most moment-to-moment richness."
  },
